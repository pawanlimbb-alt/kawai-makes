# ===================================================
# kawai.makes Environment Configuration
# ===================================================

# Server Environment
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/kawaimakes?retryWrites=true&w=majority

# JWT Authentication Secrets (generate random long strings e.g. using openssl rand -base64 32)
JWT_ACCESS_SECRET=your_jwt_access_secret_long_random_string_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_long_random_string_here

# Google OAuth (for Google Sign In)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Admin Access Allowlist (comma-separated lowercase emails)
ADMIN_EMAILS=your.email@example.com,owner@kawaimakes.com

# Payments Configuration
PAYMENT_MODE=razorpay # "razorpay" or "manual_upi"
UPI_ID=kawaimakes@upi # Used in manual_upi mode

# Razorpay API Credentials (from Razorpay Dashboard > Settings > API Keys)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Notifications
RESEND_API_KEY=re_your_resend_api_key
MAIL_FROM="kawai.makes <orders@kawaimakes.com>"
OWNER_EMAIL=owner@kawaimakes.com
TELEGRAM_BOT_TOKEN=optional_telegram_bot_token
TELEGRAM_CHAT_ID=optional_telegram_chat_id

# Cloudinary (Optional, for product image uploads)
CLOUDINARY_URL=cloudinary://key:secret@cloudname

# Frontend Vite Build-Time Variables
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id
